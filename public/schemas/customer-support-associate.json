{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Customer Support Associate Job Posting",
  "description": "Complete job posting form for Customer Support Associate positions",
  "properties": {
    "basicInfo": {
      "type": "object",
      "title": "Basic Information",
      "x-section": "basic-info",
      "properties": {
        "jobProviderName": {
          "type": "string",
          "title": "Job Provider Name",
          "description": "Enter job provider/company name",
          "minLength": 1,
          "pattern": "^\\s*\\S+\\s*$"
        },
        "jobProviderLocation": {
          "type": "string",
          "title": "Job Provider Location",
          "description": "Enter job provider location",
          "minLength": 1,
          "pattern": "^\\s*\\S+\\s*$"
        }
      },
      "required": ["jobProviderName", "jobProviderLocation"]
    },
    "jobDetails": {
      "type": "object",
      "title": "Job Details",
      "x-section": "job-details",
      "properties": {
        "title": {
          "type": "string",
          "title": "Job Title",
          "description": "Job title (editable)",
          "minLength": 1,
          "pattern": "^\\s*\\S+\\s*$"
        },
        "jobDetailsParagraph": {
          "type": "string",
          "title": "Job Details Paragraph",
          "description": "Provide a detailed description of the job responsibilities and requirements",
          "minLength": 10,
          "maxLength": 2000
        },
        "positions": {
          "type": "integer",
          "title": "Number of Openings",
          "description": "How many positions are available?",
          "minimum": 1,
          "default": 1
        },
        "minMonthlyInHand": {
          "type": "number",
          "title": "Monthly minimum in-hand salary (INR)",
          "description": "Enter minimum monthly in-hand salary amount",
          "minimum": 5000,
          "maximum": 50000
        },
        "maxMonthlyInHand": {
          "type": "number",
          "title": "Monthly maximum in-hand salary (INR)",
          "description": "Enter maximum monthly in-hand salary amount",
          "minimum": 0,
          "maximum": 50000
        }
      },
      "required": ["title", "positions"]
    },
    "jobNeeds": {
      "type": "object",
      "title": "Job Needs",
      "x-section": "job-needs",
      "properties": {
        "languageSubsection": {
          "type": "object",
          "title": "Language",
          "x-subsection": "language-subsection",
          "x-ui-subsection": "border",
          "properties": {
            "languageKnown": {
              "type": "array",
              "title": "Languages Required",
              "description": "Select all languages that the candidate should know",
              "items": {
                "type": "string",
                "enum": [
                  "Assamese",
                  "Bengali",
                  "Bodo",
                  "Dogri",
                  "English",
                  "Gujarati",
                  "Hindi",
                  "Kannada",
                  "Kashmiri",
                  "Konkani",
                  "Maithili",
                  "Malayalam",
                  "Manipuri",
                  "Marathi",
                  "Mizo",
                  "Nepali",
                  "Odia",
                  "Punjabi",
                  "Sanskrit",
                  "Santali",
                  "Sindhi",
                  "Tamil",
                  "Telugu",
                  "Urdu"
                ],
                "enumNames": [
                  "Assamese (অসমীয়া)",
                  "Bengali (বাংলা)",
                  "Bodo (बड़ो)",
                  "Dogri (डोगरी)",
                  "English",
                  "Gujarati (ગુજરાતી)",
                  "Hindi (हिन्दी)",
                  "Kannada (ಕನ್ನಡ)",
                  "Kashmiri (कॉशुर)",
                  "Konkani (कोंकणी)",
                  "Maithili (मैथिली)",
                  "Malayalam (മലയാളം)",
                  "Manipuri (মৈতৈলোন্)",
                  "Marathi (मराठी)",
                  "Mizo (Mizo ṭawng)",
                  "Nepali (नेपाली)",
                  "Odia (ଓଡ଼ିଆ)",
                  "Punjabi (ਪੰਜਾਬੀ)",
                  "Sanskrit (संस्कृतम्)",
                  "Santali (ᱥᱟᱱᱛᱟᱲᱤ)",
                  "Sindhi (سنڌي)",
                  "Tamil (தமிழ்)",
                  "Telugu (తెలుగు)",
                  "Urdu (اردو)"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            }
          }
        },
        "highestQualificationAccepted": {
          "type": "array",
          "title": "Minimum educational qualification required",
          "description": "Select the highest qualifications accepted for this position",
          "items": {
            "type": "string",
            "enum": ["12th", "Diploma", "Any Graduate"],
            "enumNames": ["12th", "Diploma", "Any Graduate"]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  }
}
