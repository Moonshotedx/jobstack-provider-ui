{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Industrial Tailor Job Posting",
  "description": "Complete job posting form for Industrial Tailor positions",
  "properties": {
    "basicInfo": {
      "type": "object",
      "title": "Basic Information",
      "x-section": "basic-info",
      "properties": {
        "jobProviderName": {
          "type": "string",
          "title": "Job Provider Name",
          "description": "Enter job provider/company name",
          "minLength": 1
        },
        "jobProviderRegistration": {
          "type": "string",
          "title": "Job Provider Registration Details",
          "description": "GST, CIN, TAN, PAN or other registration number",
          "minLength": 1,
          "pattern": "^.+$"
        },
        "jobProviderLocation": {
          "type": "string",
          "title": "Job Provider Location",
          "description": "Enter job provider location",
          "minLength": 1
        },
        "jobProviderLogo": {
          "type": "string",
          "title": "Job Provider Logo",
          "description": "Upload company logo (PNG, JPG, max 5MB)",
          "format": "data-url"
        }
      },
      "required": ["jobProviderName", "jobProviderLocation"]
    },
    "jobDetails": {
      "type": "object",
      "title": "Job Details",
      "x-section": "job-details",
      "properties": {
        "title": {
          "type": "string",
          "title": "Job Title",
          "description": "Job title (editable)",
          "minLength": 1
        },
        "positions": {
          "type": "integer",
          "title": "Number of Openings",
          "description": "How many positions are available?",
          "minimum": 1,
          "default": 1
        },
        "jobDetailsVideo": {
          "type": "string",
          "title": "Job Details Video",
          "format": "data-url",
          "description": "Upload video explaining job details (MOV, AVI, MP4, MKV, WMV, max 50MB)"
        },
        "jobLocationPhotos": {
          "type": "array",
          "title": "Job Location Photos",
          "items": {
            "type": "string",
            "format": "data-url"
          },
          "description": "Upload photos of the job location (PNG, JPEG, JPG, max 5MB each)"
        },
        "workingHoursPerDay": {
          "type": "number",
          "title": "Working Hours Per Day",
          "description": "Enter working hours per day",
          "minimum": 1,
          "maximum": 24
        },
        "monthlyInHand": {
          "type": "number",
          "title": "Monthly In-hand Salary (INR)",
          "description": "Enter monthly in-hand salary amount",
          "minimum": 0
        },
        "monthlyPfEsicBenefits": {
          "type": "number",
          "title": "Monthly PF & ESIC Benefits (INR)",
          "description": "Enter monthly PF & ESIC benefits amount",
          "minimum": 0
        },
        "monthlyAverageOT": {
          "type": "string",
          "title": "Monthly Average OT (Overtime) (INR)",
          "description": "Enter monthly average overtime amount"
        },
        "stayProvided": {
          "type": "string",
          "title": "Stay Provided",
          "enum": ["yes-free", "yes-paid", "no"],
          "enumNames": ["Yes - Free", "Yes - Paid", "No"],
          "description": "Select stay option"
        },
        "costPerSharingBed": {
          "type": "string",
          "title": "Cost per Sharing Bed",
          "description": "Enter cost per sharing bed (if stay is paid)"
        }
      },
      "required": ["title", "positions"],
      "dependencies": {
        "stayProvided": {
          "oneOf": [
            {
              "properties": {
                "stayProvided": { "enum": ["yes-paid"] },
                "costPerSharingBed": { "minLength": 1 }
              },
              "required": ["costPerSharingBed"]
            },
            {
              "properties": {
                "stayProvided": { "enum": ["yes-free", "no"] }
              }
            }
          ]
        }
      }
    },
    "jobNeeds": {
      "type": "object",
      "title": "Job Needs",
      "x-section": "job-needs",
      "properties": {
        "ageAllowedLowerLimit": {
          "type": "integer",
          "title": "Age Allowed - Lower Limit",
          "description": "Enter minimum age",
          "minimum": 18,
          "maximum": 100
        },
        "ageAllowedUpperLimit": {
          "type": "integer",
          "title": "Age Allowed - Upper Limit",
          "description": "Enter maximum age",
          "minimum": 18,
          "maximum": 100
        },
        "jukiSpeedSubsection": {
          "type": "object",
          "title": "Speed of Juki Machine Operation",
          "x-subsection": "juki-speed-subsection",
          "x-ui-subsection": "border",
          "properties": {
            "minAcceptableSpeed": {
              "type": "number",
              "title": "Min Acceptable (Unit TBD)",
              "description": "Enter minimum acceptable speed",
              "minimum": 0
            },
            "acceptableSpeedProofs": {
              "type": "array",
              "title": "Acceptable proofs for min speed",
              "description": "Select acceptable proof types for minimum speed",
              "items": {
                "type": "string",
                "enum": [
                  "speed-rating-previous-employer",
                  "speed-rating-peer",
                  "speed-rating-skilller",
                  "demo-stitching-video",
                  "other"
                ],
                "enumNames": [
                  "Speed rating by previous employer",
                  "Speed rating by peer",
                  "Speed rating by skilller",
                  "Demo stitching video",
                  "Other (specify)"
                ]
              },
              "uniqueItems": true
            },
            "speedProofOther": {
              "type": "string",
              "title": "Other proof type",
              "description": "Specify other proof type for speed verification"
            },
            "uploadSpeedSampleMedia": {
              "type": "array",
              "title": "Upload Sample media for each acceptable proof",
              "description": "Upload sample media for each acceptable proof (up to 5 files)",
              "items": {
                "type": "string",
                "format": "data-url"
              },
              "maxItems": 5
            }
          }
        },
        "jukiErrorSubsection": {
          "type": "object",
          "title": "Error rate of Juki Machine Operation (Unit TBD)",
          "x-subsection": "juki-error-subsection",
          "x-ui-subsection": "border",
          "properties": {
            "maxAcceptableError": {
              "type": "number",
              "title": "Max Acceptable (Unit TBD)",
              "description": "Enter maximum acceptable error rate",
              "minimum": 0
            },
            "acceptableErrorProofs": {
              "type": "array",
              "title": "Acceptable proofs for max error",
              "description": "Select acceptable proof types for maximum error rate",
              "items": {
                "type": "string",
                "enum": [
                  "error-free-qa-previous-employer",
                  "error-free-qa-peer",
                  "error-free-qa-skilller",
                  "demo-stitched-piece-image",
                  "other"
                ],
                "enumNames": [
                  "Error free / QA score from previous employer",
                  "Error free / QA score from peer",
                  "Error free / QA score from skilller",
                  "Demo stitched piece image",
                  "Other (specify)"
                ]
              },
              "uniqueItems": true
            },
            "errorProofOther": {
              "type": "string",
              "title": "Other proof type",
              "description": "Specify other proof type for error rate verification"
            },
            "uploadErrorSampleMedia": {
              "type": "array",
              "title": "Upload Sample media for each acceptable proof",
              "description": "Upload sample media for each acceptable proof (up to 5 files)",
              "items": {
                "type": "string",
                "format": "data-url"
              },
              "maxItems": 5
            }
          }
        },
        "relocationProofsSubsection": {
          "type": "object",
          "title": "Acceptable proofs of willingness to relocate",
          "x-subsection": "relocation-proofs-subsection",
          "x-ui-subsection": "border",
          "properties": {
            "acceptableRelocationProofs": {
              "type": "array",
              "title": "Acceptable proofs of willingness to relocate",
              "description": "Select acceptable proof types for willingness to relocate",
              "items": {
                "type": "string",
                "enum": [
                  "aadhaar-verified",
                  "travel-ticket",
                  "other"
                ],
                "enumNames": [
                  "Aadhaar verified",
                  "Travel ticket",
                  "Other (specify)"
                ]
              },
              "uniqueItems": true
            },
            "relocationProofOther": {
              "type": "string",
              "title": "Other proof type",
              "description": "Specify other proof type for relocation willingness"
            }
          }
        }
      }
    }
  },
  "required": ["basicInfo", "jobDetails", "jobNeeds"]
}