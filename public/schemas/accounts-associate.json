{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Accounts Associate Job Posting",
  "description": "Complete job posting form for Accounts Associate positions",
  "properties": {
    "basicInfo": {
      "type": "object",
      "title": "Basic Information",
      "x-section": "basic-info",
      "properties": {
        "jobProviderName": {
          "type": "string",
          "title": "Job Provider Name",
          "description": "Enter job provider/company name",
          "minLength": 1,
          "pattern": "^\\s*\\S+\\s*$"
        },
        "jobProviderLocation": {
          "type": "string",
          "title": "Job Provider Location",
          "description": "Enter job provider location",
          "minLength": 1,
          "pattern": "^\\s*\\S+\\s*$"
        }
      },
      "required": ["jobProviderName", "jobProviderLocation"]
    },
    "jobDetails": {
      "type": "object",
      "title": "Job Details",
      "x-section": "job-details",
      "properties": {
        "title": {
          "type": "string",
          "title": "Job Title",
          "description": "Job title (editable)",
          "minLength": 1,
          "pattern": "^\\s*\\S+\\s*$"
        },
        "jobDetailsParagraph": {
          "type": "string",
          "title": "Job Details Paragraph",
          "description": "Provide a detailed description of the job responsibilities and requirements",
          "minLength": 10,
          "maxLength": 2000
        },
        "positions": {
          "type": "integer",
          "title": "Number of Openings",
          "description": "How many positions are available?",
          "minimum": 1,
          "default": 1
        },
        "hiringManagerName": {
          "type": "string",
          "title": "Hiring Manager Name",
          "description": "Enter the name of the hiring manager"
        },
        "hiringManagerDesignation": {
          "type": "string",
          "title": "Hiring Manager Designation",
          "description": "Enter the designation of the hiring manager"
        },
        "minMonthlyInHand": {
          "type": "number",
          "title": "Min Monthly In-Hand",
          "description": "Enter minimum monthly in-hand salary amount",
          "minimum": 0
        },
        "maxMonthlyInHand": {
          "type": "number",
          "title": "Max Monthly In-Hand",
          "description": "Enter maximum monthly in-hand salary amount",
          "minimum": 0
        }
      },
      "required": ["title", "positions"]
    },
    "jobNeeds": {
      "type": "object",
      "title": "Job Needs",
      "x-section": "job-needs",
      "properties": {
        "highestQualificationAccepted": {
          "type": "array",
          "title": "Highest Qualification Accepted",
          "description": "Select the highest qualifications accepted for this position",
          "items": {
            "type": "string",
            "enum": ["BCom", "MCom", "MBA Finance", "BBA Finance", "Any Graduate with Excel"],
            "enumNames": ["BCom", "MCom", "MBA Finance", "BBA Finance", "Any Graduate with Excel"]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "skillsRequired": {
          "type": "array",
          "title": "Skills Required",
          "description": "Select the skills required for this position",
          "items": {
            "type": "string",
            "enum": ["MS Excel", "Tally", "Accounting Basics", "Billing"],
            "enumNames": ["MS Excel", "Tally", "Accounting Basics", "Billing"]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  }
}
